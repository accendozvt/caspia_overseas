# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SEO audit working files (Lighthouse JSON, meta audits) - not source content.
# Ignore the directory's contents but keep the written report under version control.
/seo-audit/*
!/seo-audit/SEO-REPORT.md

# Generated responsive WebP variants (scripts/generate-images.js, run as prebuild).
# Rebuilt from public/images on every build; lib/image-manifest.json IS committed so
# type-checking works without running the generator first.
/public/_img/
