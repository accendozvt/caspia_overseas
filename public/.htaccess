# =============================================================================
# Caspia Overseas Studies - Apache config for Hostinger shared hosting
#
# Lives in public/ so `next build` copies it to out/.htaccess; upload the whole
# out/ directory to public_html and this ships with it.
#
# The site is a static export with `trailingSlash: true`, so every route is a
# directory containing index.html (/study-in-germany/ -> /study-in-germany/index.html).
# Apache's DirectoryIndex and DirectorySlash already handle that pairing, so there
# are deliberately NO rewrite rules for routing here - adding them tends to break
# the automatic /path -> /path/ redirect rather than help it.
# =============================================================================

Options -Indexes
DirectoryIndex index.html
# Issues the 301 from /study-in-germany to /study-in-germany/ (default, set explicitly
# because the canonical URLs in every <link rel="canonical"> carry the trailing slash).
DirectorySlash On

# -----------------------------------------------------------------------------
# Canonical origin: https + apex (non-www)
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Any non-HTTPS request goes straight to the apex over HTTPS. The target host is
  # hardcoded rather than using %{HTTP_HOST}, so http://www.caspiaedu.com/x reaches
  # https://caspiaedu.com/x in ONE hop instead of chaining through https://www.
  # X-Forwarded-Proto is checked too because shared hosting terminates TLS upstream.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://caspiaedu.com%{REQUEST_URI} [L,R=301]

  # Already HTTPS but on www -> apex.
  RewriteCond %{HTTP_HOST} ^www\.caspiaedu\.com$ [NC]
  RewriteRule ^ https://caspiaedu.com%{REQUEST_URI} [L,R=301]

  # /index.html and /path/index.html are duplicates of / and /path/. Matching on
  # THE_REQUEST means this only fires for what the client actually typed, so it
  # cannot loop against DirectoryIndex serving index.html internally.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /%1 [L,R=301]
</IfModule>

# -----------------------------------------------------------------------------
# Error documents
# -----------------------------------------------------------------------------
# Apache serves these with the real status code, which is what makes the 404 a
# genuine 404 rather than a soft 404. /404.html is generated by next build;
# /500.html is a self-contained page in public/.
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html
ErrorDocument 502 /500.html
ErrorDocument 503 /500.html
ErrorDocument 504 /500.html

# -----------------------------------------------------------------------------
# Security headers
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
  # One year. `includeSubDomains` and `preload` are deliberately NOT set: both are
  # hard to undo, and includeSubDomains would break any subdomain (webmail, cPanel)
  # not already served over HTTPS. Add them once you have confirmed every subdomain
  # is HTTPS-only.
  Header always set Strict-Transport-Security "max-age=31536000"

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Modern equivalent of X-Frame-Options; both are sent for older-browser coverage.
  # Only frame-ancestors is set - a full CSP is not enforced here because the
  # registration form is a third-party FormFacade embed that injects its own scripts,
  # styles and images, and a strict policy would break it.
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>

# -----------------------------------------------------------------------------
# Compression
# -----------------------------------------------------------------------------

# Kept on single lines on purpose: a line-continuation backslash is fragile if the file
# ever reaches the server with CRLF endings (see .gitattributes).
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>

# -----------------------------------------------------------------------------
# Caching
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Every local .js/.css/.woff2 lives under /_next/static/ with a content hash in the
  # filename, so a change produces a new URL and these can be cached indefinitely.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images are NOT content-hashed: the WebP variants in /_img/ keep the same filename
  # when regenerated, so they get a finite TTL rather than `immutable`.
  <FilesMatch "\.(webp|avif|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # HTML, the RSC segment payloads, sitemap/robots/llms and the manifest must always
  # be revalidated, or a redeploy leaves visitors on stale pages.
  <FilesMatch "\.(html|txt|xml|webmanifest|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# -----------------------------------------------------------------------------
# MIME types (declared explicitly - shared hosting is not always current)
# -----------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddType text/plain .txt
</IfModule>

# -----------------------------------------------------------------------------
# Block dotfiles, but keep /.well-known/ reachable for TLS certificate renewal
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule (^|/)\. - [F]
</IfModule>
